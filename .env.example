# The Keepsake Smith — Environment Configuration
# NEVER commit sensitive API keys or credentials to version control.

# ── REQUIRED IN PRODUCTION ─────────────────────────────────────────────
# Shared secret for /api/admin/* and the value stored in the admin_session
# cookie. There is no built-in default: if this is unset in production every
# admin route answers 503 and nobody can sign in. Use a long random value,
# e.g. `openssl rand -hex 32`.
ADMIN_API_KEY=your_admin_secret_key_here

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=orders@thekeepsakesmith.com
BREVO_SENDER_NAME=The Keepsake Smith

# Optional PostgreSQL Database (fallback to local JSON storage if omitted)
DATABASE_URL=postgresql://user:password@hostname:5432/keepsake_db

# Bunny.net Storage & CDN Integration (Target Architecture)
# BUNNY_STORAGE_API_KEY is the STORAGE ZONE PASSWORD
# (Bunny -> Storage -> keepsake-vault -> FTP & API Access),
# NOT the account API key, which only works against api.bunny.net.
BUNNY_STORAGE_ZONE_NAME=keepsake-vault
BUNNY_STORAGE_API_KEY=your_storage_zone_password_here
BUNNY_STORAGE_REGION=de
BUNNY_CDN_HOSTNAME=keepsake-vault.b-cdn.net

# Node & Container Runtime
PORT=3000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1


# ── Required for customer media (page photos, voice notes) ──────────────
# Without these the app refuses to accept uploads in production, because the
# container filesystem is replaced on every rolling update.
#   BUNNY_STORAGE_ZONE_NAME, BUNNY_STORAGE_API_KEY, BUNNY_CDN_HOSTNAME
# BUNNY_STORAGE_REGION is the zone's region code ("de" for Falkenstein).

# Password typed on the /admin sign-in screen. Falls back to ADMIN_API_KEY
# when unset; like ADMIN_API_KEY it has no built-in default in production.
ADMIN_PASSWORD=change_me
