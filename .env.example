# The Keepsake Smith — Environment Configuration
# NEVER commit sensitive API keys or credentials to version control.

# Admin API Key for securing /api/admin/* endpoints
ADMIN_API_KEY=your_admin_secret_key_here

# Brevo (Sendinblue) Transactional Email Service
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
BREVO_SENDER_EMAIL=orders@thekeepsakesmith.com
BREVO_SENDER_NAME=The Keepsake Smith

# Optional PostgreSQL Database (fallback to local JSON storage if omitted)
DATABASE_URL=postgresql://user:password@hostname:5432/keepsake_db

# Bunny.net Storage & CDN Integration (Target Architecture)
BUNNY_STORAGE_ZONE_NAME=keepsake-vault
BUNNY_STORAGE_API_KEY=your_bunny_storage_api_key_here
BUNNY_STORAGE_REGION=de
BUNNY_CDN_HOSTNAME=cdn.thekeepsakesmith.com

# Node & Container Runtime
PORT=3000
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

